# Портал по IP сервера, пока нет домена: http://IP-СЕРВЕРА
#
# Установка:
#   sudo cp deploy/nginx-ip.conf.example /etc/nginx/sites-available/zakupki-ip
#   sudo ln -sf /etc/nginx/sites-available/zakupki-ip /etc/nginx/sites-enabled/zakupki-ip
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#
# Когда появится домен, этот файл НЕ удаляйте: в QR-наклейках, напечатанных
# до домена, зашит адрес http://IP/s/КОД. Замените блок location на редирект,
# и старые наклейки продолжат открываться:
#   location / { return 301 https://zakupki.ваш-домен.ру$request_uri; }

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Фотографии из заявок могут быть большими
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
