# ============================================================
#  Бот закупок для MAX — настройки
#  cp .env.example .env  и заполнить значения
# ============================================================

# --- MAX ----------------------------------------------------
# Токен бота от @MasterBot в MAX (/newbot).
MAX_BOT_TOKEN=

# Адрес API. Библиотека maxapi по умолчанию ходит на platform-api2.max.ru.
# Заполняйте, только если нужно переопределить (например, вернуться на старый домен):
# MAX_API_BASE=https://platform-api.max.ru

# --- Кто получает уведомления о новых заявках ---------------
# Секретное слово: отправьте боту «/admin ВАШ_КОД», и он запомнит вас.
ADMIN_CODE=смените-этот-код

# Можно сразу прописать user_id через запятую (узнать свой: команда /id боту).
ADMIN_USER_IDS=

# --- Хранилища ----------------------------------------------
# По умолчанию SQLite в data/purchases.db. Для Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/zakupki  (нужен pip install asyncpg)
DATABASE_URL=

# Redis хранит шаги незаполненных заявок, чтобы они пережили перезапуск.
# Без него шаги хранятся в памяти процесса — этого обычно достаточно.
REDIS_URL=

# --- Веб-панель ---------------------------------------------
PANEL_ENABLED=true
PANEL_HOST=127.0.0.1
PANEL_PORT=8080

# Только для docker: с каким адресом публиковать порт наружу.
# 127.0.0.1 — панель доступна только с самого сервера (через nginx),
# 0.0.0.0   — панель открыта по http://IP-сервера:8080 (пароль пойдёт без шифрования).
PANEL_BIND=127.0.0.1

# Логины и пароли панели: "логин:пароль,логин2:пароль2"
PANEL_USERS="admin:смените-пароль"

# Ключ подписи cookie:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Внешний адрес панели — попадает ссылкой в уведомления бота.
# PANEL_PUBLIC_URL=https://zakupki.example.ru

# true, когда панель работает по HTTPS (cookie станет Secure).
PANEL_SECURE_COOKIE=false
PANEL_SESSION_DAYS=30

# --- Прочее --------------------------------------------------
# Писать ли автору заявки при смене статуса.
NOTIFY_AUTHOR=true

# Часовой пояс для дат (смещение от UTC): 3 — Москва, 5 — Екатеринбург, 7 — Красноярск.
DISPLAY_TZ_OFFSET=3

LOG_LEVEL=INFO
